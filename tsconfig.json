{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vitest/globals", "node"],
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src", "tests", "vite.config.ts", "vitest.config.ts"]
}
